# ============================================================
# Configuration — Système d'Archivage Intelligent NouvelAir
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ── Base de données PostgreSQL ───────────────────────────────
# Port 5434 (non standard pour éviter les conflits)
DATABASE_URL=postgresql+asyncpg://postgres:VOTRE_MOT_DE_PASSE@localhost:5434/nouv_db

# ── Chemins archives ─────────────────────────────────────────
# Chemin vers le dossier racine des archives PDF
ARCHIVE_ROOT_PATH=C:\chemin\vers\vos\archives\Aircraft

# Dossier temporaire pour les uploads (créé automatiquement)
UPLOAD_PATH=C:\chemin\vers\uploads_temp

# ── API Groq (NER v6 — extraction entités aéronautiques) ─────
# Gratuit sur https://console.groq.com
GROQ_API_KEY=gsk_VOTRE_CLE_GROQ

# ── Sécurité JWT ─────────────────────────────────────────────
SECRET_KEY=changez-cette-cle-en-production-minimum-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Upload ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100

# ── Power BI (optionnel) ─────────────────────────────────────
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=

# ── Environnement ────────────────────────────────────────────
# development ou production
ENVIRONMENT=development
DEBUG=true
